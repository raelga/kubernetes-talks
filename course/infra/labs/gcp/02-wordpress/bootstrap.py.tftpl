#!/usr/bin/python3
"""Fetch credentials with the VM identity and configure WordPress and Cloud SQL."""
import base64
import grp
import ipaddress
import json
import os
from pathlib import Path
import re
import sys
import tempfile
import time
from urllib.parse import quote

import pymysql
import requests

PROJECT = ${jsonencode(project_id)}
DB_HOST = ${jsonencode(db_host)}
DB_NAME = ${jsonencode(db_name)}
DB_USER = ${jsonencode(db_user)}
DB_ADMIN_USER = ${jsonencode(db_admin_user)}
ADMIN_SECRET = ${jsonencode(db_admin_secret_id)}
APP_SECRET = ${jsonencode(db_app_secret_id)}
SALTS_SECRET = ${jsonencode(wp_salts_secret_id)}
SERVER_CA = ${jsonencode(db_server_ca)}
CA_FILE = "/etc/wordpress-cloud-sql-ca.pem"
SALT_NAMES = (
    "AUTH_KEY", "SECURE_AUTH_KEY", "LOGGED_IN_KEY", "NONCE_KEY",
    "AUTH_SALT", "SECURE_AUTH_SALT", "LOGGED_IN_SALT", "NONCE_SALT",
)


def write_file(path, content, mode, group=0):
    """Replace a file atomically without ever exposing its contents by default."""
    directory = os.path.dirname(path)
    fd, temp = tempfile.mkstemp(prefix=".wordpress-", dir=directory)
    try:
        os.fchmod(fd, mode)
        os.fchown(fd, 0, group)
        with os.fdopen(fd, "w", encoding="utf-8") as output:
            output.write(content)
        os.replace(temp, path)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


def secret_payload(session, secret_id):
    # IAM bindings and newly created secret versions may take time to propagate.
    url = "https://secretmanager.googleapis.com/v1/projects/{}/secrets/{}/versions/latest:access".format(
        quote(PROJECT, safe=""), quote(secret_id, safe="")
    )
    for attempt in range(24):
        try:
            token_response = session.get(
                "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token",
                headers={"Metadata-Flavor": "Google"}, timeout=10,
            )
            token_response.raise_for_status()
            token = token_response.json()["access_token"]
            response = session.get(url, headers={"Authorization": "Bearer " + token}, timeout=15)
            response.raise_for_status()
            return base64.b64decode(response.json()["payload"]["data"], validate=True).decode("utf-8")
        except (requests.RequestException, KeyError, ValueError):
            if attempt == 23:
                raise RuntimeError("Unable to read a required Secret Manager secret") from None
            time.sleep(10)


def php_string(value):
    if not isinstance(value, str) or not value or "\x00" in value:
        raise ValueError("Secret values must be nonempty UTF-8 strings without NUL bytes")
    return "'" + value.replace("\\", "\\\\").replace("'", "\\'") + "'"


def connect_admin(password):
    for attempt in range(30):
        try:
            return pymysql.connect(
                host=DB_HOST, user=DB_ADMIN_USER, password=password,
                ssl={"ca": CA_FILE, "check_hostname": False},
                connect_timeout=10, read_timeout=30, write_timeout=30, autocommit=True,
            )
        except pymysql.MySQLError:
            if attempt == 29:
                raise RuntimeError("Unable to connect to Cloud SQL with verified TLS") from None
            time.sleep(10)


def main():
    # Names interpolated into SQL and stunnel configuration must not contain syntax.
    ipaddress.ip_address(DB_HOST)
    if not re.fullmatch(r"[A-Za-z0-9_]{1,64}", DB_NAME):
        raise ValueError("Invalid database name")
    if not re.fullmatch(r"[A-Za-z0-9_]{1,32}", DB_USER):
        raise ValueError("Invalid database user")
    if not SERVER_CA.startswith("-----BEGIN CERTIFICATE-----"):
        raise ValueError("Missing Cloud SQL server CA")

    session = requests.Session()
    session.trust_env = False
    admin_password = secret_payload(session, ADMIN_SECRET)
    app_password = secret_payload(session, APP_SECRET)
    salts = json.loads(secret_payload(session, SALTS_SECRET))
    if not isinstance(salts, dict) or any(name not in salts for name in SALT_NAMES):
        raise ValueError("WordPress salts secret is missing required keys")
    # Validate before modifying the database or writing configuration.
    php_string(app_password)
    for name in SALT_NAMES:
        php_string(salts[name])

    write_file(CA_FILE, SERVER_CA.rstrip() + "\n", 0o644)
    with connect_admin(admin_password) as connection:
        with connection.cursor() as cursor:
            # The account can only operate on this database, and must use TLS.
            cursor.execute("CREATE USER IF NOT EXISTS %s@'%%' IDENTIFIED BY %s REQUIRE SSL", (DB_USER, app_password))
            cursor.execute("ALTER USER %s@'%%' IDENTIFIED BY %s REQUIRE SSL", (DB_USER, app_password))
            cursor.execute(
                "GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX, DROP, "
                "CREATE TEMPORARY TABLES, LOCK TABLES ON `" + DB_NAME + "`.* TO %s@'%%'",
                (DB_USER,),
            )
    del admin_password

    # Cloud SQL's instance-specific CA authenticates its server certificate.
    # The certificate's identity is not its private IP, so this checks the chain
    # rather than attempting a hostname match against that IP.
    os.makedirs("/etc/stunnel", mode=0o755, exist_ok=True)
    write_file("/etc/stunnel/wordpress.conf", """foreground = yes
pid =
client = yes
[wordpress-cloud-sql]
accept = 127.0.0.1:3307
connect = {host}:3306
CAfile = {ca}
verifyChain = yes
""".format(host=DB_HOST, ca=CA_FILE), 0o644)
    write_file("/etc/systemd/system/wordpress-db-tunnel.service", """[Unit]
Description=Authenticated TLS tunnel to WordPress Cloud SQL
Wants=network-online.target
After=network-online.target

[Service]
User=www-data
Group=www-data
ExecStart=/usr/bin/stunnel4 /etc/stunnel/wordpress.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
""", 0o644)

    config = "<?php\n"
    for name, value in (
        ("DB_NAME", DB_NAME), ("DB_USER", DB_USER), ("DB_PASSWORD", app_password),
        ("DB_HOST", "127.0.0.1:3307"), ("DB_CHARSET", "utf8mb4"), ("DB_COLLATE", ""),
    ):
        # DB_COLLATE is intentionally empty, as required by the standard WP config.
        encoded = "''" if name == "DB_COLLATE" else php_string(value)
        config += "define({}, {});\n".format(php_string(name), encoded)
    for name in SALT_NAMES:
        config += "define({}, {});\n".format(php_string(name), php_string(salts[name]))
    config += ("$table_prefix = 'wp_';\n"
               "define('WP_DEBUG', false);\n"
               "if (!defined('ABSPATH')) { define('ABSPATH', __DIR__ . '/'); }\n"
               "require_once ABSPATH . 'wp-settings.php';\n")
    write_file("/var/www/html/wp-config.php", config, 0o640, grp.getgrnam("www-data").gr_gid)


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        # Never log exception details: database or API errors may contain secrets.
        print("WordPress bootstrap failed ({}); inspect VM and service configuration.".format(type(exc).__name__), file=sys.stderr)
        sys.exit(1)
