# Copy to terraform.tfvars and replace the account and DOCUMENTATION IPv4 address.
account_id     = "123456789012"
aws_region     = "us-east-1"
lab_id         = "ec2-demo"
client_cidr    = "203.0.113.10/32"
instance_type  = "t3.micro"
repository_ref = "main" # Prefer the full SHA of a published commit containing this lab.

# Optional HTTPS: both must be set. Use a NEW hostname in an existing public zone.
# domain_name    = "ec2-demo.example.com"
# hosted_zone_id = "Z0123456789EXAMPLE"
