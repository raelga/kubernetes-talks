#!/opt/infra-lab/venv/bin/python3
"""Refresh WordPress credentials only after provisioning the database user."""

import fcntl
import grp
import json
import os
import re
import ssl
import sys
import tempfile

import boto3
from botocore.config import Config
import pymysql


CONFIG_DIR = '/etc/infra-lab'
CREDENTIALS_FILE = os.path.join(CONFIG_DIR, 'database.json')
CA_FILE = os.path.join(CONFIG_DIR, 'global-bundle.pem')
SALT_NAMES = (
    'AUTH_KEY', 'SECURE_AUTH_KEY', 'LOGGED_IN_KEY', 'NONCE_KEY',
    'AUTH_SALT', 'SECURE_AUTH_SALT', 'LOGGED_IN_SALT', 'NONCE_SALT',
)


def nonempty_string(value):
    return isinstance(value, str) and bool(value)


def secret_string(client, secret_id):
    value = client.get_secret_value(SecretId=secret_id).get('SecretString')
    if not nonempty_string(value):
        raise ValueError('Invalid secret')
    return value


def validate_application(app):
    if not isinstance(app, dict) or app.get('username') != 'wp_split_app':
        raise ValueError('Invalid application credentials')
    if not all(nonempty_string(app.get(key)) for key in ('password', 'host', 'dbname')):
        raise ValueError('Invalid application credentials')
    if not re.fullmatch(r'[A-Za-z0-9_]+', app['dbname'], flags=re.ASCII):
        raise ValueError('Invalid database name')
    salts = app.get('salts')
    if not isinstance(salts, dict) or not all(nonempty_string(salts.get(key)) for key in SALT_NAMES):
        raise ValueError('Invalid salts')


def provision_database(app, admin):
    if not isinstance(admin, dict) or not all(
        nonempty_string(admin.get(key)) for key in ('username', 'password')
    ):
        raise ValueError('Invalid administrator credentials')

    # A verified context enforces both the RDS CA chain and the endpoint hostname.
    context = ssl.create_default_context(cafile=CA_FILE)
    connection_options = {
        'host': app['host'],
        'port': 3306,
        'connect_timeout': 10,
        'ssl': context,
    }
    db = pymysql.connect(user=admin['username'], password=admin['password'], **connection_options)
    try:
        with db.cursor() as cursor:
            # Keep parameter escaping independent of the server's default SQL mode.
            cursor.execute("SET SESSION sql_mode = 'NO_ENGINE_SUBSTITUTION'")
            # Identifiers are validated above and the account name is fixed.
            cursor.execute("CREATE DATABASE IF NOT EXISTS `" + app['dbname'] + "`")
            cursor.execute(
                "CREATE USER IF NOT EXISTS 'wp_split_app'@'%%' IDENTIFIED BY %s REQUIRE SSL",
                (app['password'],),
            )
            cursor.execute(
                "ALTER USER 'wp_split_app'@'%%' IDENTIFIED BY %s REQUIRE SSL",
                (app['password'],),
            )
            # The identifier is restricted to ASCII letters, digits and underscores above.
            cursor.execute(
                "GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, DROP, INDEX ON `"
                + app['dbname'] + "`.* TO 'wp_split_app'@'%'"
            )
    finally:
        db.close()

    # Do not publish credentials until the restricted account can use the database.
    application = pymysql.connect(
        user=app['username'], password=app['password'], database=app['dbname'], **connection_options
    )
    application.close()


def publish_credentials(raw):
    path = None
    try:
        fd, path = tempfile.mkstemp(prefix='database.json.', dir=CONFIG_DIR)
        with os.fdopen(fd, 'wb') as output:
            os.fchown(output.fileno(), 0, grp.getgrnam('apache').gr_gid)
            os.fchmod(output.fileno(), 0o640)
            output.write(raw)
            output.flush()
            os.fsync(output.fileno())
        os.replace(path, CREDENTIALS_FILE)
        path = None
    finally:
        if path is not None:
            os.unlink(path)


def main():
    os.umask(0o077)
    with open(os.path.join(CONFIG_DIR, 'fetch-credentials.lock'), 'a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        client = boto3.client(
            'secretsmanager', region_name='${region}',
            config=Config(retries={'mode': 'standard', 'max_attempts': 3}),
        )
        raw = secret_string(client, '${secret_arn}').encode('utf-8')
        app = json.loads(raw)
        validate_application(app)
        try:
            with open(CREDENTIALS_FILE, 'rb') as current:
                if current.read() == raw:
                    return
        except FileNotFoundError:
            pass
        admin = json.loads(secret_string(client, '${admin_secret_arn}'))
        provision_database(app, admin)
        publish_credentials(raw)


if __name__ == '__main__':
    try:
        main()
    except Exception:
        # API and driver exceptions can contain credentials or SQL statements.
        print('Credential refresh failed.', file=sys.stderr)
        sys.exit(1)
