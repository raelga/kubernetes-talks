#!/bin/bash
set -euo pipefail
umask 077

config_dir=/etc/infra-lab
exec 9>"$config_dir/fetch-credentials.lock"
flock 9

temporary_file=''
trap 'if [[ -n "$temporary_file" ]]; then rm -f -- "$temporary_file"; fi' EXIT
trap 'exit 1' HUP INT TERM
temporary_file=$(mktemp "$config_dir/database.json.XXXXXX")

# Keep secret contents out of command arguments, stdout and error logs.
aws secretsmanager get-secret-value \
  --secret-id '${secret_arn}' \
  --region '${region}' \
  --query SecretString \
  --output text > "$temporary_file" 2>/dev/null

# Accept exactly one complete application secret before replacing the last good copy.
jq -e -s '
  length == 1 and (
    .[0]
    | type == "object"
      and .username == "wordpress_app"
      and all(.password, .host, .dbname; type == "string" and length > 0)
      and (.salts | type == "object"
        and all(
          .AUTH_KEY, .SECURE_AUTH_KEY, .LOGGED_IN_KEY, .NONCE_KEY,
          .AUTH_SALT, .SECURE_AUTH_SALT, .LOGGED_IN_SALT, .NONCE_SALT;
          type == "string" and length > 0
        ))
  )
' "$temporary_file" >/dev/null 2>&1

chown root:apache "$temporary_file"
chmod 0640 "$temporary_file"
mv -f -- "$temporary_file" "$config_dir/database.json"
temporary_file=''
