#!/bin/sh
set -eu
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y python3
install -d -m 0755 /opt/upc
cat > /opt/upc/app.py <<'UPC_PYTHON'
${app_source}
UPC_PYTHON
chmod 0644 /opt/upc/app.py
cat > /etc/systemd/system/upc-http.service <<'UPC_UNIT'
[Unit]
Description=UPC HTTP Python
After=network-online.target
Wants=network-online.target
[Service]
User=nobody
Group=nogroup
Environment=LAB_PROVIDER=gcp
Environment=LAB_ID=${lab_id}
ExecStart=/usr/bin/python3 /opt/upc/app.py
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
UPC_UNIT
systemctl daemon-reload
systemctl enable --now upc-http.service
