# Copy to backend.hcl and use your existing private, versioned state bucket.
# Web and database stages MUST use this same key, directory and workspace.
bucket              = "YOUR-STATE-BUCKET"
key                 = "infra/wordpress/YOUR-LAB-ID/terraform.tfstate"
region              = "us-east-1"
encrypt             = true
use_lockfile        = true
allowed_account_ids = ["000000000000"]
