#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y --no-install-recommends python3
useradd --system --home-dir /opt/upc-http --shell /usr/sbin/nologin upclab
install -d -m 0755 /opt/upc-http
printf '%s' '${app_base64}' | base64 --decode > /opt/upc-http/app.py
printf '%s' '${config_base64}' | base64 --decode > /opt/upc-http/config.json
chmod 0644 /opt/upc-http/app.py /opt/upc-http/config.json
cat > /etc/systemd/system/upc-http.service <<'SERVICE'
[Unit]
Description=UPC HTTP Python without containers
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=upclab
Group=upclab
ExecStart=/usr/bin/python3 /opt/upc-http/app.py --host 0.0.0.0 --port 80 --config /opt/upc-http/config.json
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
SERVICE
systemctl daemon-reload
systemctl enable --now upc-http.service
